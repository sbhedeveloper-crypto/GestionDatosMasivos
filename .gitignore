.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
airflow-logs/

# Docker
.dockerignore

# Cómo empaquetar
dist/
build/
*.egg-info/
*.egg
